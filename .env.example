# La Goyniela API — example env vars. Copy to .env and fill in.
# NOTE: never commit a real .env with secrets. .env is gitignored.

ENV=
DATABASE_URL=
LOG_LEVEL=
CORS_ORIGINS=
# API_FOOTBALL_KEY=your_key_here

# Auth
JWT_SECRET=
JWT_ALGORITHM=
JWT_EXPIRATION_MINUTES=

# OAuth providers — leave placeholders until you have real Client IDs
GOOGLE_CLIENT_ID=
X_CLIENT_ID=
X_CLIENT_SECRET=
